<Window x:Class="Forms1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Forms1"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="900"
        Background="WhiteSmoke" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- Стиль кнопок -->
        <Style x:Key="AnimatedButton" TargetType="Button">
            <Setter Property="Background" Value="#E6E6FA"/>
            <Setter Property="BorderBrush" Value="#3333FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#3333FF" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1.05" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                To="1.05" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль элементов списка -->
        <Style x:Key="AnimatedItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="6"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F0F8FF"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3333FF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.X"
                                                To="5" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="b"
                                                Storyboard.TargetProperty="RenderTransform.X"
                                                To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E6E6FA"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#3333FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль карточек -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#3333FF" BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль вкладок -->
        <Style x:Key="AnimatedTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="6,6,6,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b"
                        CornerRadius="8"
                        Background="#F0F8FF"
                        BorderBrush="#3333FF"
                        BorderThickness="2"
                        Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#3333FF"
                                          BlurRadius="8"
                                          ShadowDepth="2"
                                          Opacity="0.15"/>
                            </Border.Effect>
                            <ContentPresenter ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Подсветка при наведении -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E6E6FA"/>
                            </Trigger>

                            <!-- Активная вкладка -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E6E6FA"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3333FF"
                                                  BlurRadius="14"
                                                  ShadowDepth="3"
                                                  Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Шаблон TabControl с линией-разделителем под вкладками -->
        <Style x:Key="AnimatedTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Шапка вкладок -->
                            <TabPanel Grid.Row="0"
                              IsItemsHost="True"
                              Background="Transparent"
                              Margin="0,4,0,4"/>

                            <!-- Тонкая линия-разделитель -->
                            <Border Grid.Row="1"
                            Height="1"
                            Margin="0,4,0,10"
                            Background="#3333FF"
                            Opacity="0.35"/>

                            <!-- Содержимое выбранной вкладки -->
                            <ContentPresenter Grid.Row="2"
                                      ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <TabControl x:Name="MainTabs"
                    Style="{StaticResource AnimatedTabControl}"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource AnimatedTabItem}"/>
            </TabControl.Resources>

            <!-- ======================= ВКЛАДКА 1: НОЧНИК ======================= -->
            <TabItem Header="Ночник">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--Верхний заголовок -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#3333FF" BorderThickness="2"
                            Padding="5" Margin="0,0,0,10" Background="#E6E6FA"
                            Style="{StaticResource Card}">
                        <TextBlock Text="Ночник" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="Black"/>
                    </Border>

                    <!-- ЛЕВАЯ ПАНЕЛЬ -->
                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="2"
                                Padding="5" Margin="0,0,0,5" Background="#E6E6FA"
                                Style="{StaticResource Card}">
                            <TextBlock Text="Операции" HorizontalAlignment="Center" FontSize="18"/>
                        </Border>

                        <ListBox x:Name="OperationsListBox" Grid.Row="1"
                                 BorderBrush="#3333FF" BorderThickness="2"
                                 Background="#F0F8FF"
                                 ItemContainerStyle="{StaticResource AnimatedItem}"
                                 SelectionChanged="OperationsListBox_SelectionChanged"/>
                    </Grid>

                    <!-- ПРАВАЯ ПАНЕЛЬ -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Карточка операции -->
                        <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="2"
                                Padding="5" Margin="0,0,0,5" Background="#E6E6FA"
                                Style="{StaticResource Card}">
                            <TextBlock Text="Карточка операции" HorizontalAlignment="Center" FontSize="18"/>
                        </Border>

                        <!-- label1 -->
                        <Border Grid.Row="1" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,0,5" Background="#F0F8FF"
                                CornerRadius="8">
                            <Label x:Name="label1" Content="" Padding="5" FontSize="14" />
                        </Border>

                        <!-- Параметры -->
                        <Border Grid.Row="2" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,0,5" Background="#E6E6FA"
                                CornerRadius="8">
                            <TextBlock Text="Параметры:" HorizontalAlignment="Center" Padding="5" FontSize="16"/>
                        </Border>

                        <!-- Область ввода параметров + кнопка Выполнить -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="2" Background="#F0F8FF" Margin="0,0,0,10"
                                    CornerRadius="8">
                                <StackPanel x:Name="FuncControlsPanel"/>
                            </Border>

                            <Button Grid.Row="1" Content="Выполнить" Click="Run_Click" Width="120"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource AnimatedButton}"/>
                        </Grid>

                        <!-- Блок Предусловие / Постусловие / Результат -->
                        <Grid Grid.Row="4" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- ПРЕДУСЛОВИЕ -->
                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,5,2" Background="White">
                                <Label x:Name="labelPreconditionColor" Width="15" Height="15" Background="Gray" Margin="2"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="#3333FF" BorderThickness="1" Background="#E6E6FA" Margin="0,0,5,2" Padding="2">
                                <Label Content="Предусловие:" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,0,2" Padding="2">
                                <Label x:Name="labelPreconditionValue" Content="" VerticalAlignment="Center"/>
                            </Border>

                            <!-- ПОСТУСЛОВИЕ -->
                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,5,2" Background="White">
                                <Label x:Name="labelPostconditionColor" Width="15" Height="15" Background="Gray" Margin="2"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#3333FF" BorderThickness="1" Background="#E6E6FA" Margin="0,0,5,2" Padding="2">
                                <Label Content="Постусловие:" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" BorderBrush="#3333FF" BorderThickness="1" Margin="0,0,0,2" Padding="2">
                                <Label x:Name="labelPostconditionValue" Content="" VerticalAlignment="Center"/>
                            </Border>

                            <!-- РЕЗУЛЬТАТ -->
                            <Border Grid.Row="2" Grid.Column="1" BorderBrush="#3333FF" BorderThickness="1" Background="#E6E6FA" Margin="0,0,5,0" Padding="2">
                                <Label Content="Результат:" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" BorderBrush="#3333FF" BorderThickness="1" Padding="2">
                                <Label x:Name="labelResult" Content="" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Кнопка Контракт -->
                        <Button Grid.Row="5" Content="Контракт" Click="Contract_Click" Width="120"
                                HorizontalAlignment="Right" Margin="0,0,0,5"
                                Style="{StaticResource AnimatedButton}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============== ВКЛАДКА 2: КОНСТРУКТОР ФРАГМЕНТА ============== -->
            <TabItem Header="Конструктор фрагмента">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0" BorderBrush="#3333FF" BorderThickness="2"
                            Padding="5" Margin="0,0,0,10" Background="#E6E6FA"
                            Style="{StaticResource Card}">
                        <TextBlock Text="Конструктор фрагмента" HorizontalAlignment="Center"
                                   FontSize="22" FontWeight="Bold"/>
                    </Border>

                    <!-- Цель (Post) -->
                    <Border Grid.Row="1" BorderBrush="#3333FF" BorderThickness="1"
                            Padding="6" Margin="0,0,0,8" Background="#F0F8FF"
                            Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Цель (Post):" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtPost" Height="50"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="#3333FF" Background="White"/>
                        </StackPanel>
                    </Border>

                    <!-- Код фрагмента -->
                    <Border Grid.Row="2" BorderBrush="#3333FF" BorderThickness="1"
                            Padding="6" Margin="0,0,0,8" Background="#F0F8FF"
                            Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Код фрагмента:" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtCode" Height="140"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     BorderBrush="#3333FF" Background="White"/>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки + пресеты -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="cmbPresets" Grid.Column="0"
                                  Height="32" VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  BorderBrush="#3333FF">
                            <ComboBoxItem Content="— выбрать пресет —" IsSelected="True"/>
                        </ComboBox>

                        <Button x:Name="btnCalc" Grid.Column="1" Content="Рассчитать wp"
                                Click="CalcWp_Click" Margin="0,0,8,0"
                                Style="{StaticResource AnimatedButton}"/>

                        <Button x:Name="btnTriad" Grid.Column="2" Content="Показать триаду"
                                Click="ShowTriad_Click"
                                Style="{StaticResource AnimatedButton}"/>
                    </Grid>

                    <!-- Трейс -->
                    <Border Grid.Row="4" BorderBrush="#3333FF" BorderThickness="1"
                            Margin="0,0,0,8" Background="#F0F8FF"
                            Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel x:Name="pnlTrace">
                                <TextBlock Text="Здесь появится пошаговый трейс..."
                                           Foreground="Gray" FontStyle="Italic"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Итоговое wp -->
                    <Border Grid.Row="5" BorderBrush="#3333FF" BorderThickness="2"
                            Padding="6" Background="#E6E6FA"
                            Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Итоговое предусловие (wp):" FontSize="14" FontWeight="Bold"/>
                            <Label x:Name="lblWpResult" Content="—" FontSize="14" Padding="4"
                                FontFamily="Consolas"/>

                            <TextBlock Text="Человеческим языком:" FontSize="14" FontWeight="Bold"
                                Margin="0,4,0,0"/>
                            <TextBlock x:Name="lblWpHuman" Text="—" FontSize="14" Margin="4,2,4,2"
                                TextWrapping="Wrap"/>

                            <TextBlock Text="Условия определённости:" FontSize="14" FontWeight="Bold"
                                Margin="0,4,0,0"/>
                            <TextBlock x:Name="lblDefinedness" Text="—" FontSize="14" Margin="4,2,4,2"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>